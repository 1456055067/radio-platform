# Site agent as a sandboxed systemd service.
#   groupadd --system radio-agent
#   install -m 0755 scanner-agent /usr/local/bin/
#   install -d -m 0750 -o root -g radio-agent /etc/radio
#   cp agent.toml, agent.pem, agent-key.pem (0640 root:radio-agent), ca.pem to /etc/radio/
#   set state_dir = "/var/lib/radio-agent" in agent.toml
#   systemctl enable --now radio-agent
# Not yet tested on a systemd host; check with `systemd-analyze security radio-agent`.
# The agent needs outbound TCP to the gateway and UDP/TCP to scanners on
# the site LAN only. It listens on nothing.
[Unit]
Description=radio-platform site agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStartPre=/usr/local/bin/scanner-agent --check-config /etc/radio/agent.toml
ExecStart=/usr/local/bin/scanner-agent /etc/radio/agent.toml
Restart=on-failure
RestartSec=5s
# SIGTERM: the agent flushes its journal and disconnects cleanly.
KillSignal=SIGTERM
TimeoutStopSec=20s

DynamicUser=yes
# Reads the key material in /etc/radio (0640 root:radio-agent).
SupplementaryGroups=radio-agent
StateDirectory=radio-agent
StateDirectoryMode=0700
Environment=RUST_LOG=info

# Sandbox.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
ReadOnlyPaths=/etc/radio

[Install]
WantedBy=multi-user.target
